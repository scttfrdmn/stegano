name: Develop Integration Pipeline

on:
  push:
    branches: [ develop ]
  schedule:
    # Run nightly integration tests
    - cron: '0 2 * * *'

env:
  CARGO_TERM_COLOR: always
  RUST_BACKTRACE: 1

jobs:
  # Comprehensive integration testing
  integration-tests:
    name: Integration Test Suite
    runs-on: ${{ matrix.os }}
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest, macos-latest, windows-latest]
        
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
        with:
          fetch-depth: 0  # Full history for better analysis
          
      - name: Setup Rust toolchain
        uses: actions-rs/toolchain@v1
        with:
          toolchain: stable
          components: rustfmt, clippy
          override: true
          
      - name: Cache cargo
        uses: actions/cache@v4
        with:
          path: |
            ~/.cargo/registry
            ~/.cargo/git
            target
          key: ${{ runner.os }}-integration-cargo-${{ hashFiles('**/Cargo.lock') }}
          
      - name: Install system dependencies (Linux)
        if: runner.os == 'Linux'
        run: |
          sudo apt-get update
          sudo apt-get install -y \
            pkg-config \
            libssl-dev \
            libudev-dev \
            mesa-vulkan-drivers \
            vulkan-tools \
            valgrind
            
      - name: Install system dependencies (macOS)
        if: runner.os == 'macOS'
        run: |
          brew install pkg-config openssl
          
      - name: Install system dependencies (Windows)
        if: runner.os == 'Windows'
        run: |
          # Windows-specific dependencies if needed
          echo "Windows environment ready"
          
      - name: Full test suite
        run: |
          cargo test --all-features --release --verbose
          
      - name: Integration tests
        run: |
          cargo test --test '*' --all-features --release
          
      - name: Example tests
        run: |
          # Test that all examples compile and run
          for example in examples/**/*.rs; do
            if [ -f "$example" ]; then
              example_name=$(basename "$example" .rs)
              echo "Testing example: $example_name"
              if cargo run --example "$example_name" --all-features --release 2>/dev/null; then
                echo "✅ Example $example_name runs successfully"
              else
                echo "⚠️ Example $example_name failed or requires interaction"
              fi
            fi
          done
        shell: bash
        
      - name: Benchmark comparison
        if: runner.os == 'Linux'
        run: |
          cargo bench --all-features
          
      - name: Memory leak detection
        if: runner.os == 'Linux'
        run: |
          cargo build --release --all-features
          echo "Running memory leak detection on critical paths..."
          # Add specific memory leak tests here
          
  # Performance regression testing
  performance-analysis:
    name: Performance Analysis
    runs-on: ubuntu-latest
    
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
        with:
          fetch-depth: 0
          
      - name: Setup Rust toolchain
        uses: actions-rs/toolchain@v1
        with:
          toolchain: stable
          override: true
          
      - name: Cache cargo
        uses: actions/cache@v4
        with:
          path: |
            ~/.cargo/registry
            ~/.cargo/git
            target
          key: ubuntu-performance-cargo-${{ hashFiles('**/Cargo.lock') }}
          
      - name: Install benchmark tools
        run: |
          cargo install cargo-criterion
          
      - name: Run comprehensive benchmarks
        run: |
          cargo criterion --all-features --message-format=json > benchmark_results.json
          
      - name: Analyze performance trends
        run: |
          echo "Analyzing performance trends..."
          # Add script to compare with previous benchmarks
          python3 scripts/analyze_performance.py benchmark_results.json || echo "Performance analysis script not available"
          
      - name: Upload benchmark results
        uses: actions/upload-artifact@v4
        with:
          name: develop-benchmarks-${{ github.sha }}
          path: |
            benchmark_results.json
            target/criterion/
          retention-days: 90
          
  # Security and vulnerability scanning
  security-scan:
    name: Security Analysis
    runs-on: ubuntu-latest
    
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
        
      - name: Setup Rust toolchain
        uses: actions-rs/toolchain@v1
        with:
          toolchain: stable
          override: true
          
      - name: Install security tools
        run: |
          cargo install cargo-audit cargo-deny
          
      - name: Dependency audit
        run: |
          cargo audit
          
      - name: License compliance check
        run: |
          cargo deny check licenses
          
      - name: Security advisory check
        run: |
          cargo deny check advisories
          
      - name: Banned dependencies check
        run: |
          cargo deny check bans
          
      - name: SAST scanning
        uses: github/super-linter@v4
        env:
          DEFAULT_BRANCH: develop
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          VALIDATE_RUST_2015: false
          VALIDATE_RUST_2018: true
          VALIDATE_RUST_CLIPPY: true

  # Documentation validation and generation
  documentation:
    name: Documentation Build & Validation
    runs-on: ubuntu-latest
    
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
        
      - name: Setup Rust toolchain
        uses: actions-rs/toolchain@v1
        with:
          toolchain: stable
          override: true
          
      - name: Cache cargo
        uses: actions/cache@v4
        with:
          path: |
            ~/.cargo/registry
            ~/.cargo/git
            target
          key: ubuntu-docs-cargo-${{ hashFiles('**/Cargo.lock') }}
          
      - name: Build documentation
        run: |
          cargo doc --all-features --no-deps --verbose
          
      - name: Check documentation coverage
        run: |
          echo "Checking documentation coverage..."
          cargo doc --all-features --no-deps 2>&1 | tee doc_output.txt
          
          # Count undocumented items
          undocumented=$(grep -c "warning: missing documentation" doc_output.txt || echo "0")
          total_items=$(grep -c "documenting" doc_output.txt || echo "1")
          
          if [ "$total_items" -gt "0" ]; then
            coverage=$(echo "scale=2; ($total_items - $undocumented) * 100 / $total_items" | bc -l)
            echo "Documentation coverage: ${coverage}%"
            
            if (( $(echo "$coverage >= 95" | bc -l) )); then
              echo "✅ Documentation coverage acceptable: ${coverage}%"
            else
              echo "❌ Documentation coverage too low: ${coverage}%"
              exit 1
            fi
          fi
          
      - name: Test documentation examples
        run: |
          cargo test --doc --all-features
          
      - name: Build user guides
        run: |
          if command -v mdbook &> /dev/null; then
            echo "Building user guide with mdbook..."
            cd docs && mdbook build
          else
            echo "mdbook not available, skipping user guide build"
          fi
          
      - name: Deploy documentation (if on main develop)
        if: github.ref == 'refs/heads/develop'
        run: |
          echo "Preparing documentation deployment..."
          # Add documentation deployment logic here
          
  # Code quality metrics
  quality-metrics:
    name: Code Quality Analysis
    runs-on: ubuntu-latest
    
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
        with:
          fetch-depth: 0
          
      - name: Setup Rust toolchain
        uses: actions-rs/toolchain@v1
        with:
          toolchain: stable
          components: rustfmt, clippy
          override: true
          
      - name: Install quality tools
        run: |
          cargo install cargo-tarpaulin tokei
          
      - name: Code coverage analysis
        run: |
          cargo tarpaulin --all-features --out xml --timeout 300
          
      - name: Lines of code analysis
        run: |
          tokei . --output json > loc_report.json
          cat loc_report.json
          
      - name: Complexity analysis
        run: |
          # Use clippy for complexity warnings
          cargo clippy --all-features -- -W clippy::cognitive_complexity -W clippy::too_many_arguments
          
      - name: Upload coverage to Codecov
        uses: codecov/codecov-action@v3
        with:
          file: ./cobertura.xml
          flags: develop-integration
          name: develop-coverage
          
      - name: Quality gate check
        run: |
          coverage=$(grep 'line-rate=' cobertura.xml | head -1 | grep -o 'line-rate="[^"]*"' | grep -o '[0-9.]*')
          echo "Current coverage: ${coverage}%"
          
          # Enforce quality gates
          if (( $(echo "$coverage >= 0.95" | bc -l) )); then
            echo "✅ Coverage gate passed"
          else
            echo "❌ Coverage gate failed: ${coverage}% < 95%"
            exit 1
          fi

  # Cross-feature compatibility testing
  compatibility-matrix:
    name: Feature Compatibility
    runs-on: ubuntu-latest
    strategy:
      matrix:
        feature_set:
          - "default"
          - "gpu"
          - "metal"
          - "enterprise" 
          - "gpu,enterprise"
          - "all-features"
          - "no-default-features"
          
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
        
      - name: Setup Rust toolchain
        uses: actions-rs/toolchain@v1
        with:
          toolchain: stable
          override: true
          
      - name: Test feature combination
        run: |
          echo "Testing feature set: ${{ matrix.feature_set }}"
          
          if [ "${{ matrix.feature_set }}" = "no-default-features" ]; then
            cargo test --no-default-features
          elif [ "${{ matrix.feature_set }}" = "default" ]; then
            cargo test
          elif [ "${{ matrix.feature_set }}" = "all-features" ]; then
            cargo test --all-features
          else
            cargo test --features "${{ matrix.feature_set }}"
          fi

  # GPU-specific integration testing
  gpu-integration:
    name: GPU Integration Tests
    runs-on: ubuntu-latest
    
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
        
      - name: Setup Rust toolchain
        uses: actions-rs/toolchain@v1
        with:
          toolchain: stable
          override: true
          
      - name: Install GPU dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y mesa-vulkan-drivers vulkan-tools
          
      - name: Test GPU detection and fallback
        run: |
          echo "Testing GPU capabilities..."
          vulkaninfo || echo "No Vulkan support - testing CPU fallback"
          
          # Test GPU feature compilation
          cargo test --features gpu --verbose
          
      - name: GPU performance validation
        run: |
          echo "Running GPU performance tests..."
          cargo test --features gpu --release gpu_performance || echo "GPU performance tests require hardware"

  # Long-running stress tests
  stress-tests:
    name: Stress Testing
    runs-on: ubuntu-latest
    if: github.event_name == 'schedule' || contains(github.event.head_commit.message, '[stress]')
    
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
        
      - name: Setup Rust toolchain
        uses: actions-rs/toolchain@v1
        with:
          toolchain: stable
          override: true
          
      - name: Memory stress test
        run: |
          echo "Running memory stress tests..."
          cargo test --release stress_test_memory --features all-features || echo "Stress tests not implemented"
          
      - name: Concurrency stress test
        run: |
          echo "Running concurrency stress tests..."
          cargo test --release stress_test_concurrent --features all-features || echo "Concurrency tests not implemented"
          
      - name: Large data stress test
        run: |
          echo "Running large data stress tests..."
          cargo test --release stress_test_large_data --features all-features || echo "Large data tests not implemented"

  # Deployment readiness check
  deployment-readiness:
    name: Deployment Readiness
    needs: [integration-tests, performance-analysis, security-scan, documentation, quality-metrics]
    runs-on: ubuntu-latest
    
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
        
      - name: Check deployment readiness
        run: |
          echo "🔍 Checking deployment readiness..."
          
          # Check if all required jobs passed
          if [ "${{ needs.integration-tests.result }}" = "success" ] && \
             [ "${{ needs.performance-analysis.result }}" = "success" ] && \
             [ "${{ needs.security-scan.result }}" = "success" ] && \
             [ "${{ needs.documentation.result }}" = "success" ] && \
             [ "${{ needs.quality-metrics.result }}" = "success" ]; then
            echo "✅ All quality gates passed - ready for release preparation"
          else
            echo "❌ Some quality gates failed - not ready for deployment"
            exit 1
          fi
          
      - name: Generate integration report
        run: |
          echo "📊 Integration Report for commit ${{ github.sha }}" > integration_report.md
          echo "=================================" >> integration_report.md
          echo "" >> integration_report.md
          echo "- ✅ Integration tests: ${{ needs.integration-tests.result }}" >> integration_report.md
          echo "- ✅ Performance analysis: ${{ needs.performance-analysis.result }}" >> integration_report.md
          echo "- ✅ Security scan: ${{ needs.security-scan.result }}" >> integration_report.md
          echo "- ✅ Documentation: ${{ needs.documentation.result }}" >> integration_report.md
          echo "- ✅ Quality metrics: ${{ needs.quality-metrics.result }}" >> integration_report.md
          echo "" >> integration_report.md
          echo "**Status: Ready for release preparation** 🚀" >> integration_report.md
          
          cat integration_report.md
          
      - name: Upload integration report
        uses: actions/upload-artifact@v4
        with:
          name: integration-report-${{ github.sha }}
          path: integration_report.md
          retention-days: 30

  # Notification and status updates
  notify-status:
    name: Status Notification
    needs: [deployment-readiness]
    runs-on: ubuntu-latest
    if: always()
    
    steps:
      - name: Notify team on success
        if: needs.deployment-readiness.result == 'success'
        run: |
          echo "✅ Develop branch integration successful!"
          echo "Ready for feature merges and release preparation."
          
      - name: Notify team on failure
        if: needs.deployment-readiness.result == 'failure'
        run: |
          echo "❌ Develop branch integration failed!"
          echo "Please review failed checks before merging new features."
          
          # Add notification logic here (Slack, Discord, etc.)
          # curl -X POST -H 'Content-type: application/json' \
          #   --data '{"text":"🚨 Develop branch CI failed for stegano"}' \
          #   ${{ secrets.SLACK_WEBHOOK_URL }}

  # Automated dependency updates (weekly)
  dependency-updates:
    name: Dependency Updates
    runs-on: ubuntu-latest
    if: github.event_name == 'schedule'
    
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
        with:
          token: ${{ secrets.GITHUB_TOKEN }}
          
      - name: Setup Rust toolchain
        uses: actions-rs/toolchain@v1
        with:
          toolchain: stable
          override: true
          
      - name: Update dependencies
        run: |
          cargo update
          
      - name: Test with updated dependencies
        run: |
          cargo test --all-features
          
      - name: Create PR for dependency updates
        if: success()
        run: |
          if ! git diff --quiet Cargo.lock; then
            git config --local user.email "action@github.com"
            git config --local user.name "GitHub Action"
            git checkout -b automated-dependency-update-$(date +%Y%m%d)
            git add Cargo.lock
            git commit -m "chore: automated dependency updates

            - Updated all dependencies to latest compatible versions
            - All tests pass with updated dependencies
            - Generated by automated workflow"
            git push origin HEAD
            
            gh pr create \
              --title "chore: automated dependency updates" \
              --body "Automated dependency updates. All tests pass." \
              --base develop \
              --head automated-dependency-update-$(date +%Y%m%d)
          fi
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}