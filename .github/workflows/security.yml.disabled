name: Security Audit
on:
  push:
    branches: [ master, main ]
  pull_request:
    branches: [ master, main ]
  schedule:
    # Run security audit daily at 2 AM UTC
    - cron: '0 2 * * *'

jobs:
  security_audit:
    runs-on: ubuntu-latest
    name: Security audit
    steps:
      - uses: actions/checkout@v4
      
      - name: Install Rust
        uses: dtolnay/rust-toolchain@stable
        
      - name: Cache dependencies
        uses: actions/cache@v4
        with:
          path: |
            ~/.cargo/registry
            ~/.cargo/git
            target
          key: ${{ runner.os }}-cargo-${{ hashFiles('**/Cargo.lock') }}
          
      - name: Install cargo-audit
        run: cargo install --force cargo-audit
        
      - name: Install cargo-deny
        run: cargo install --force cargo-deny
        
      - name: Run cargo audit
        run: cargo audit
        
      - name: Run cargo deny
        run: cargo deny check
        
      - name: Run dependency check
        run: |
          echo "=== Dependency Analysis ==="
          echo "Total dependencies:"
          cargo tree --depth 1 | wc -l
          echo
          echo "Direct dependencies:"
          cargo tree --depth 1
          echo
          echo "=== License Check ==="
          cargo deny check licenses
          echo
          echo "=== Vulnerability Check ==="
          cargo deny check advisories

  supply_chain_audit:
    runs-on: ubuntu-latest
    name: Supply chain audit
    steps:
      - uses: actions/checkout@v4
      
      - name: Install Rust
        uses: dtolnay/rust-toolchain@stable
        
      - name: Cache dependencies
        uses: actions/cache@v4
        with:
          path: |
            ~/.cargo/registry
            ~/.cargo/git
            target
          key: ${{ runner.os }}-cargo-${{ hashFiles('**/Cargo.lock') }}
          
      - name: Generate dependency report
        run: |
          echo "=== Supply Chain Analysis ===" > supply_chain_report.txt
          echo "Generated on: $(date)" >> supply_chain_report.txt
          echo >> supply_chain_report.txt
          
          echo "=== Direct Dependencies ===" >> supply_chain_report.txt
          cargo tree --depth 1 >> supply_chain_report.txt
          echo >> supply_chain_report.txt
          
          echo "=== All Dependencies (Limited) ===" >> supply_chain_report.txt
          cargo tree --depth 3 >> supply_chain_report.txt
          echo >> supply_chain_report.txt
          
          echo "=== Outdated Dependencies ===" >> supply_chain_report.txt
          cargo install cargo-outdated || true
          cargo outdated >> supply_chain_report.txt || echo "cargo-outdated failed" >> supply_chain_report.txt
          echo >> supply_chain_report.txt
          
      - name: Upload supply chain report
        uses: actions/upload-artifact@v4
        with:
          name: supply-chain-report
          path: supply_chain_report.txt